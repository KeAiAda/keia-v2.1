# Настройки LLM (Polza AI или любой OpenAI-совместимый API)
LLM_BASE_URL=https://polza.ai/api/v1
LLM_API_KEY=твой_ключ_сюда
LLM_MODEL=google/gemini-2.5-flash
LLM_UTILITY_MODEL=google/gemini-2.5-flash-lite
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.8
LLM_HISTORY_LIMIT=10

# Discord
DISCORD_TOKEN=твой_токен_бота
OWNER_ID=твой_discord_id

# Настройки Кеи
BOT_NAME_RU=Кея
