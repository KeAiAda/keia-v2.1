# ============================================
# KEIA — что НЕ попадает в git
# ============================================

# --- Секреты ---
.env
.env.local
*.key

# --- Виртуальное окружение Python ---
.venv/
venv/
env/

# --- Python-мусор ---
__pycache__/
*.py[cod]
*.so
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Личные данные Кеи (НЕ выкладываем на GitHub) ---
memory/

# --- Модели (огромные, лежат вне проекта) ---
*.gguf
*.bin
*.safetensors

# --- IDE и редакторы ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS-мусор ---
.DS_Store
Thumbs.db

# --- Логи ---
*.log
